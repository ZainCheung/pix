{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pix-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_CHANNEL",
        "class_name": "RelayChannel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayChannel"]
    }
  ]
}
